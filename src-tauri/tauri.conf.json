{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "langnext-app",
	"version": "0.1.0",
	"identifier": "com.balaenis.langnext-app",
	"build": {
		"beforeDevCommand": "mise run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "mise run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/black-bg/icon.ico"
		]
	}
}
