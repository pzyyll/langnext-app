{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "trusted-app",
  "description": "Trusted application WebViews (main, quick-translate, screenshot-overlay): app-local IPC commands, core window/tray, global shortcut, clipboard, dialog, fs text files, opener, and logging. Granted by explicit webview labels only; no windows glob match and no plugin-page label.",
  "webviews": ["main", "quick-translate", "screenshot-overlay"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-create",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-title",
    "core:tray:default",
    "global-shortcut:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-read-image",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "opener:default",
    "log:default",
    "allow-trusted-app-commands"
  ]
}
