#!/usr/bin/env bash
# ABOUTME: Package the Tauri desktop app installers and a portable zip
# ABOUTME: Run via `mise run tauri:build`; forwards extra args to `tauri build`
#MISE description="Package installers and portable zip"
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"

# Gate A is mandatory for every packaged build. Do not add a skip flag: packaging fails closed
# unless release-owned public roots, signed archives, and exact policies verify.
mise run plugin:verify-release-bundle

tauri build "$@"
node scripts/package-portable.js
