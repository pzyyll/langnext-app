#!/usr/bin/env bash
# ABOUTME: Package the Tauri desktop app installers and a portable zip
# ABOUTME: Runs the structural built-in gate first, then `tauri build` and the portable zip
#MISE description="Package installers and portable zip"
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"

# Mandatory gate for every packaged build. Do not add a skip flag: packaging fails closed unless
# every shipped built-in plugin validates structurally (manifest, indexed files, path safety,
# size bounds, Native source rules, no-WASI). There is no plugin-level signature to verify:
# built-in authenticity comes from the signed application installer itself.
mise run plugin:check-builtins

tauri build "$@"
node scripts/package-portable.js
