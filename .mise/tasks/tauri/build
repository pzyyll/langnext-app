#!/usr/bin/env bash
# ABOUTME: Package the Tauri desktop app installers and a portable zip
# ABOUTME: Run via `mise run tauri:build`; forwards extra args to `tauri build`
#MISE description="Package installers and portable zip"
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$root"

tauri build "$@"
node scripts/package-portable.js
