#!/usr/bin/env bash
#MISE description="Package the desktop application (default target: this platform)."
set -euo pipefail

# `nsh package` builds the runner on the host it runs on, so the host platform is
# the default target. An explicit `--target` in the arguments takes precedence.
current_target() {
  case "$(uname -s)" in
    Darwin) echo macos ;;
    Linux) echo linux ;;
    MINGW* | MSYS* | CYGWIN*) echo windows ;;
    *)
      echo "package: cannot infer the target platform from '$(uname -s)'; pass --target explicitly." >&2
      return 1
      ;;
  esac
}

args=("$@")
has_target=false
for arg in "$@"; do
  case "$arg" in
    --target | --target=*) has_target=true ;;
  esac
done

if [ "$has_target" = false ]; then
  target="$(current_target)"
  echo "package: target $target"
  args+=(--target "$target")
fi

nsh package . "${args[@]}"
