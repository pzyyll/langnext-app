#!/usr/bin/env bash
# ABOUTME: Emit reviewed vendor bootstrap policy JSON from already signed and verified archives.
# ABOUTME: Never reads private keys; requires an external vendor public root.
#MISE description="Generate bootstrap policy JSON from signed archives (args: archives --public-key-hex|file)"
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: mise run plugin:generate-bootstrap-policy -- <archive.lnplugin...> --public-key-hex <hex>" >&2
  echo "   or: mise run plugin:generate-bootstrap-policy -- <archive.lnplugin...> --public-key-file <path>" >&2
  echo "   or: mise run plugin:generate-bootstrap-policy -- <archive.lnplugin...> --vendor-trust-file <path>" >&2
  exit 2
fi

if [[ "${1:-}" == "--" ]]; then
  shift
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "$ROOT_DIR"

cargo run --manifest-path src-tauri/Cargo.toml --bin plugin_release_tool --quiet -- generate-bootstrap-policy "$@"
