      "sha256": "$SCHEMA_SHA"
    }
  ],
  "capabilities": [{ "id": "ocr.image@1" }],
  "configurationSchema": "$SCHEMA_PATH",
  "configSchemaVersion": 1,
  "credentialSlots": [],
  "permissions": { "network": [], "authPolicies": [] },
  "ui": { "mode": "schema", "pages": [] },
  "modelResources": [
    {
      "id": "pp-ocrv6-medium",
      "version": "1.0.0",
      "modelApiVersion": 1,
      "languageSet": "pp-ocrv6-50lang",
      "totalDownloadBytes": 139130880,
      "expandedBytes": 139110993,
      "licenseId": "paddleocr-model-weights",
      "licenseNoticePath": "$LICENSE_PATH",
      "artifacts": [
        {
          "role": "detection",
          "url": "https://paddle-model-ecology.bj.bcebos.com/paddlex/official_inference_model/paddle3.0.0/PP-OCRv6_medium_det_infer.tar",
          "bytes": 62279680,
