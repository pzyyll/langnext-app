}
EOF

mise run plugin:sign-staging -- "$STAGING" "$VENDOR_SEED"
mise run plugin:finalize-package -- "$STAGING" "$OUT_PACKAGE" --public-key-hex "$PUBLIC_KEY_HEX"
mise run plugin:verify -- "$OUT_PACKAGE" --public-key-hex "$PUBLIC_KEY_HEX"

echo "ok: paddleocr smoke package written to $OUT_PACKAGE"
echo "note: protocol-stub runtime only; not a production release artifact"
