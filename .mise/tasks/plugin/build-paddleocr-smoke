    "keyId": "$VENDOR_KEY_ID",
    "keyFingerprint": "$FINGERPRINT"
  },
  "runtime": {
    "kind": "trusted-native-worker",
    "artifact": "$WORKER_PATH",
    "nativeProtocolVersion": 1,
    "nativeDependencies": ["$DLL_B_PATH", "$DLL_A_PATH"]
  },
  "targets": [{ "platform": "windows", "architecture": "x86_64" }],
  "files": [
    {
      "path": "$WORKER_PATH",
