#!/usr/bin/env bash
# ABOUTME: Build a vendor-signed PaddleOCR smoke fixture package for UI/lifecycle smoke only.
# ABOUTME: Uses a protocol-stub runtime payload; never treat this package as a production release.
#MISE description="Build signed PaddleOCR smoke fixture package (protocol stub; not production)"
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "$ROOT_DIR"

PLUGIN_DIR="$ROOT_DIR/runtime-plugins/paddleocr"
STAGING_ROOT="$ROOT_DIR/runtime-plugins/dist/staging"
STAGING="$STAGING_ROOT/com.langnext.paddleocr-1.0.0-smoke"
OUT_DIR="$PLUGIN_DIR/fixtures/packages"
OUT_PACKAGE="$OUT_DIR/com.langnext.paddleocr-1.0.0.lnplugin"
PUBLIC_KEY_FILE="$ROOT_DIR/runtime-plugins/conformance/fixtures/packages/keys/vendor-public-key.hex"
VENDOR_SEED="0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
VENDOR_KEY_ID="com.langnext.vendor.keys.1"
WORKER_PATH="runtime/worker.exe"
DLL_A_PATH="runtime/paddle_inference.dll"
DLL_B_PATH="runtime/opencv_world.dll"
LICENSE_PATH="licenses/NOTICE.txt"
SCHEMA_PATH="schemas/config.json"

if [[ ! -f "$PUBLIC_KEY_FILE" ]]; then
  echo "error: vendor public key fixture missing: $PUBLIC_KEY_FILE" >&2
  exit 1
fi
PUBLIC_KEY_HEX="$(tr -d '[:space:]' < "$PUBLIC_KEY_FILE")"
if [[ ${#PUBLIC_KEY_HEX} -ne 64 || ! "$PUBLIC_KEY_HEX" =~ ^[0-9a-f]+$ ]]; then
  echo "error: vendor public key must be 64 lowercase hex characters" >&2
  exit 1
fi

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

FINGERPRINT="$(printf '%s' "$PUBLIC_KEY_HEX" | python -c 'import sys,hashlib,binascii; print(hashlib.sha256(binascii.unhexlify(sys.stdin.read().strip())).hexdigest())')"

rm -rf "$STAGING"
mkdir -p "$STAGING/runtime" "$STAGING/licenses" "$STAGING/schemas" "$OUT_DIR"

# Smoke package ships a real PE protocol fixture worker so CreateProcess/handshake can succeed.
# This is still not production PaddleOCR (no Inference/OpenCV runtime, fixed OCR text).
mise run plugin:build-native-conformance
CONFORMANCE_EXE="$ROOT_DIR/runtime-plugins/conformance/native-worker/target/release/native-worker-conformance.exe"
if [[ ! -f "$CONFORMANCE_EXE" ]]; then
  # cargo on Unix may omit .exe; prefer the platform binary that exists.
  CONFORMANCE_EXE="$ROOT_DIR/runtime-plugins/conformance/native-worker/target/release/native-worker-conformance"
fi
if [[ ! -f "$CONFORMANCE_EXE" ]]; then
  echo "error: native-worker conformance binary missing after build" >&2
  exit 1
fi
cp "$CONFORMANCE_EXE" "$STAGING/$WORKER_PATH"
# Placeholder dependency files satisfy the signed runtime inventory; the fixture worker does not load them.
printf 'smoke-paddle-inference-dll\n' >"$STAGING/$DLL_A_PATH"
printf 'smoke-opencv-world-dll\n' >"$STAGING/$DLL_B_PATH"
cp "$PLUGIN_DIR/licenses/NOTICE.txt" "$STAGING/$LICENSE_PATH"
cp "$PLUGIN_DIR/schemas/config.json" "$STAGING/$SCHEMA_PATH"

WORKER_BYTES="$(wc -c <"$STAGING/$WORKER_PATH" | tr -d ' ')"
DLL_A_BYTES="$(wc -c <"$STAGING/$DLL_A_PATH" | tr -d ' ')"
DLL_B_BYTES="$(wc -c <"$STAGING/$DLL_B_PATH" | tr -d ' ')"
LICENSE_BYTES="$(wc -c <"$STAGING/$LICENSE_PATH" | tr -d ' ')"
SCHEMA_BYTES="$(wc -c <"$STAGING/$SCHEMA_PATH" | tr -d ' ')"
WORKER_SHA="$(sha256_file "$STAGING/$WORKER_PATH")"
DLL_A_SHA="$(sha256_file "$STAGING/$DLL_A_PATH")"
DLL_B_SHA="$(sha256_file "$STAGING/$DLL_B_PATH")"
LICENSE_SHA="$(sha256_file "$STAGING/$LICENSE_PATH")"
SCHEMA_SHA="$(sha256_file "$STAGING/$SCHEMA_PATH")"

# modelResources match host-pinned PP-OCRv6 medium constants; package contains no model bytes.
cat >"$STAGING/plugin.json" <<EOF
{
  "manifestVersion": 1,
  "pluginApiVersion": "1.0",
  "id": "com.langnext.paddleocr",
  "version": "1.0.0",
