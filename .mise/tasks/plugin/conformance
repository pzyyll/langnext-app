#!/usr/bin/env bash
# ABOUTME: Run Wasm runtime and installed-lifecycle conformance suites with required tests.
# ABOUTME: Fail-closed: missing required tests or zero tests is an error; capture suite exit without set -e.
#MISE description="Run plugin conformance suite (arg: wasm|installed-lifecycle|all)"
set -uo pipefail

MODE="${1:-all}"

REQUIRED_WASM_TESTS=(
  "services::wasm_runtime::tests::wasm_executor::conformance_modes_fixture_manifest_matches_runtime"
  "services::wasm_runtime::tests::wasm_executor::detect_conformance_modes_fixture_manifest_matches_runtime"
  "services::wasm_runtime::tests::wasm_executor::success_mode"
  "services::wasm_runtime::tests::wasm_executor::broker_call_mode"
  "services::wasm_runtime::tests::wasm_executor::denied_endpoint_mode"
  "services::wasm_runtime::tests::wasm_executor::trap_mode_maps_to_plugin_unavailable"
  "services::wasm_runtime::tests::wasm_executor::oversized_output_rejected"
  "services::wasm_runtime::tests::wasm_executor::memory_growth_rejected"
  "services::wasm_runtime::tests::wasm_executor::slow_host_call_times_out"
  "services::wasm_runtime::tests::wasm_executor::cancellation_propagates"
  "services::wasm_runtime::tests::wasm_executor::detect_world_success"
  "services::wasm_runtime::tests::wasm_executor::translate_and_detect_manifest_grant_closed_loop"
  "services::wasm_runtime::tests::wasm_limits::infinite_loop_exhausts_fuel"
  "services::wasm_runtime::tests::wasm_host_imports::undeclared_import_component_fails_instantiation"
  "services::wasm_runtime::tests::wasm_limits::package_a_component_rejected_under_package_b_grant"
  "services::wasm_runtime::tests::wasm_host_imports::relative_path_confinement_rejects_absolute_and_traversal"
  "services::wasm_runtime::tests::wasm_host_imports::blocked_request_headers_rejected"
  "services::wasm_runtime::tests::wasm_host_imports::max_request_bytes_over_limit_rejected"
  "services::wasm_runtime::tests::wasm_host_imports::broker_blob_and_stream_response_are_stable_unsupported"
)

REQUIRED_LIFECYCLE_TESTS=(
  "services::runtime_lifecycle_installed_tests::runtime_compatible_migration_translate_detect_upgrade_rollback_uninstall"
  "services::runtime_lifecycle_installed_tests::runtime_upgrade_apply_failure_injection_leaves_source_unchanged"
  "services::runtime_lifecycle_installed_tests::runtime_discard_snapshot_and_migration_trap_no_mutation"
  "services::runtime_lifecycle_installed_tests::runtime_plugin_export_v7_missing_package_restores_unresolved_exact_requirement"
  "services::runtime_lifecycle_installed_tests::runtime_rollback_stale_preview_and_missing_snapshot_fail_closed"
  "services::runtime_lifecycle_installed_tests::runtime_router_selects_wasm_adapter_for_active_pin"
  "services::runtime_lifecycle_preference_tests::runtime_preference_snapshot_is_pre_migration_and_rollback_restores_exact_json"
  "services::runtime_lifecycle_preference_tests::runtime_rollback_restores_grant_from_snapshot_when_live_grant_missing"
  "services::runtime_lifecycle_preference_tests::runtime_preference_stale_cas_fails_without_partial_mutation"
  "services::runtime_lifecycle_preference_tests::runtime_preference_byte_exact_whitespace_preserved_in_snapshot"
  "services::runtime_lifecycle_preference_tests::runtime_rollback_foreign_or_stale_dependency_fails_closed"
  "services::runtime_lifecycle_preference_tests::runtime_grant_snapshot_tamper_matrix_fails_closed"
  "services::runtime_lifecycle_preference_tests::runtime_uninstall_blocks_pin_grant_snapshot_dependencies_and_preserves_files"
  "services::runtime_lifecycle::tests::runtime_upgrade_preview_missing_package_fails_closed"
  "services::runtime_lifecycle::tests::runtime_upgrade_apply_unknown_preview_is_conflict"
  "services::runtime_lifecycle::tests::runtime_rollback_without_snapshot_fails_closed"
  "services::runtime_router::tests::runtime_router_bundle_round_trip_preserves_authority"
  "services::runtime_router::tests::runtime_router_cross_instance_grant_lookup_denied"
  "domain::import_export::tests::runtime_plugin_export_v7_maps_legacy_integrations_to_bundled_rust"
  "storage::migrations::tests::migrate_v16_to_v17_backfills_bundled_runtime_pins"
  "repositories::tests::runtime_instance_pin_backfill_and_constraints"
  "repositories::tests::runtime_instance_pin_package_approval_never_authorizes_execution"
)

REQUIRED_GOOGLE_WEB_TESTS=(
  "services::google_translate_web_runtime_tests::google_translate_web_runtime_gtx_translate_and_detect"
  "services::google_translate_web_runtime_tests::google_translate_web_runtime_gtx_cancellation"
  "services::google_translate_web_runtime_tests::google_translate_web_runtime_gtx_rate_limit_maps_to_rate_limited"
  "services::google_translate_web_runtime_tests::google_translate_web_runtime_gtx_invalid_response_maps_to_invalid_response"
  "services::google_translate_web_runtime_tests::google_translate_web_runtime_single_executor_no_fallback"
  "services::google_translate_web_runtime_tests::google_translate_web_runtime_timeout_maps_to_timeout"
  "services::google_translate_web_runtime_tests::google_translate_web_runtime_bundled_rollback_remains_available"
  "services::google_translate_web_runtime_tests::vendor_package_bootstrap_is_idempotent_and_sets_default"
  "services::google_translate_web_runtime_tests::vendor_bootstrap_imports_proxy_version_without_changing_default"
  "services::google_translate_web_runtime_tests::google_web_package_verifies_with_vendor_public_key"
  "services::google_translate_web_runtime_tests::google_translate_web_proxy_channel_translates_and_detect_stays_on_gtx"
  "services::google_translate_web_runtime_tests::google_translate_web_proxy_url_change_requires_new_grant"
  "services::google_translate_web_runtime_tests::google_web_new_instance_pins_default_wasm_package"
  "services::google_translate_web_runtime_tests::google_web_new_instance_falls_back_to_bundled_when_no_default_package"
  "services::google_translate_web_runtime_tests::google_web_migration_rejects_incompatible_capability_major"
  "services::google_translate_web_runtime_tests::google_web_migration_rejects_schema_incompatible_target"
)

MIN_TOTAL_TESTS=10

run_filter_suite() {
  local filter="$1"
  shift
  local -a required=("$@")
  local OUTPUT EXIT_CODE TOTAL_PASSED count name

  # Capture exit code without aborting under errexit (set +e around cargo).
  set +e
  OUTPUT=$(cargo test --manifest-path src-tauri/Cargo.toml "$filter" -- --nocapture 2>&1)
  EXIT_CODE=$?
  set -e
  echo "$OUTPUT"
  if [[ $EXIT_CODE -ne 0 ]]; then
    echo "error: conformance tests failed for filter=$filter (exit $EXIT_CODE)" >&2
    exit 1
  fi

  TOTAL_PASSED=0
  while read -r count; do
    [[ -n "$count" ]] || continue
    TOTAL_PASSED=$((TOTAL_PASSED + count))
  done < <(echo "$OUTPUT" | grep -E '^test result: ok\.' | awk '{print $4}')

  if [[ "$filter" == "wasm_runtime" && "$TOTAL_PASSED" -lt "$MIN_TOTAL_TESTS" ]]; then
    echo "error: conformance suite ran $TOTAL_PASSED tests; expected at least $MIN_TOTAL_TESTS (fail-closed)" >&2
    exit 1
  fi

  for name in "${required[@]}"; do
    if ! grep -Eq "test ${name} \\.\\.\\. ok" <<<"$OUTPUT"; then
      echo "error: required conformance test missing or not ok: $name" >&2
      exit 1
    fi
  done
  echo "ok: $filter suite passed ($TOTAL_PASSED tests; ${#required[@]} required names verified)"
}

set -e

case "$MODE" in
  wasm)
    run_filter_suite "wasm_runtime" "${REQUIRED_WASM_TESTS[@]}"
    ;;
  installed-lifecycle)
    # Full install→migrate→Translate/Detect→approval→upgrade→rollback→uninstall suite.
    run_filter_suite "runtime_" "${REQUIRED_LIFECYCLE_TESTS[@]}"
    ;;
  all)
    run_filter_suite "wasm_runtime" "${REQUIRED_WASM_TESTS[@]}"
    run_filter_suite "runtime_" "${REQUIRED_LIFECYCLE_TESTS[@]}"
    run_filter_suite "google_translate_web_runtime" "${REQUIRED_GOOGLE_WEB_TESTS[@]}"
    ;;
  google-web|google-web-gtx|google-web-proxy)
    cargo test --manifest-path runtime-plugins/google-translate-web/protocol/Cargo.toml -- --nocapture
    run_filter_suite "google_translate_web_runtime" "${REQUIRED_GOOGLE_WEB_TESTS[@]}"
    ;;
  *)
    echo "usage: mise run plugin:conformance [wasm|installed-lifecycle|all]" >&2
    exit 1
    ;;
esac
