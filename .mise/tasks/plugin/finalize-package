#!/usr/bin/env bash
# ABOUTME: Canonical signed-archive finalization from an externally signed staging tree.
# ABOUTME: Never reads private keys; requires a trusted public key to Ed25519-verify exact plugin.json bytes.
#MISE description="Finalize a signed package (args: staging-dir output.lnplugin --public-key-hex|file)"
set -euo pipefail

if [[ $# -lt 3 ]]; then
  echo "usage: mise run plugin:finalize-package -- <staging-dir> <output.lnplugin> --public-key-hex <hex>" >&2
  echo "   or: mise run plugin:finalize-package -- <staging-dir> <output.lnplugin> --public-key-file <path>" >&2
  exit 2
fi

if [[ "${1:-}" == "--" ]]; then
  shift
fi

cargo run --manifest-path src-tauri/Cargo.toml --bin plugin_tool --quiet -- finalize-package "$@"
