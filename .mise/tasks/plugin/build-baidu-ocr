#!/usr/bin/env bash
# ABOUTME: Deterministically build the Baidu OCR Component and unsigned release staging tree.
# ABOUTME: No signing input exists; plugin:pack turns the staging tree into an unsigned archive.
#MISE description="Build Baidu OCR no-WASI Component and unsigned staging tree"
set -euo pipefail

EXPECTED_CARGO_COMPONENT="0.21.1"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
PLUGIN_DIR="$ROOT_DIR/runtime-plugins/baidu-ocr"
STAGING="$ROOT_DIR/runtime-plugins/dist/staging/com.langnext.baidu-ocr-1.0.0"
COMPONENT="$PLUGIN_DIR/ocr/target/wasm32-unknown-unknown/release/langnext_baidu_ocr.wasm"
FIXTURE="$PLUGIN_DIR/ocr/fixtures/langnext-baidu-ocr.wasm"

actual_version="$(cargo component --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
if [[ "$actual_version" != "$EXPECTED_CARGO_COMPONENT" ]]; then
  echo "error: cargo-component $actual_version != pinned $EXPECTED_CARGO_COMPONENT" >&2
  exit 1
fi

cargo test --manifest-path "$PLUGIN_DIR/protocol/Cargo.toml" --locked
cargo component build --manifest-path "$PLUGIN_DIR/ocr/Cargo.toml" --target wasm32-unknown-unknown --release --locked

expected_digest="$(awk '{print $1}' "$FIXTURE.sha256")"
actual_digest="$(sha256sum "$COMPONENT" | awk '{print $1}')"
if [[ "$actual_digest" != "$expected_digest" ]] || ! cmp -s "$COMPONENT" "$FIXTURE"; then
  echo "error: Baidu OCR Component drifted from the committed fixture" >&2
  echo "  committed: $expected_digest" >&2
  echo "  rebuilt:   $actual_digest" >&2
  echo "run plugin:refresh-baidu-ocr-fixture only for an intentional fixture update" >&2
  exit 1
fi

rm -rf "$STAGING"
mkdir -p "$STAGING/ocr/fixtures" "$STAGING/schemas"
cp "$PLUGIN_DIR/plugin.json" "$STAGING/plugin.json"
cp "$FIXTURE" "$STAGING/ocr/fixtures/langnext-baidu-ocr.wasm"
cp "$PLUGIN_DIR/schemas/config.json" "$STAGING/schemas/config.json"
cp "$PLUGIN_DIR/schemas/ocr-preferences.json" "$STAGING/schemas/ocr-preferences.json"

bun -e '
const fs = require("fs");
const crypto = require("crypto");
const path = require("path");
const root = process.argv[1];
const manifest = JSON.parse(fs.readFileSync(path.join(root, "plugin.json"), "utf8"));
for (const file of manifest.files) {
  const bytes = fs.readFileSync(path.join(root, file.path));
  const digest = crypto.createHash("sha256").update(bytes).digest("hex");
  if (bytes.length !== file.bytes || digest !== file.sha256) {
    console.error(`error: manifest index mismatch for ${file.path}`);
    process.exit(1);
  }
}
' "$STAGING"

echo "ok: unsigned Baidu OCR staging tree at $STAGING"
echo "note: archives are unsigned; mise run plugin:pack produces them"
