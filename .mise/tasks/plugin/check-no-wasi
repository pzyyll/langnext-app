#!/usr/bin/env bash
# ABOUTME: Assert no WASI host implementation is linked into the Tauri backend or imported by
# ABOUTME: the conformance guests. Fail-closed: requires exact wasm_guest_imports test coverage.
#MISE description="Assert no WASI in host dependency tree or guest imports"
set -euo pipefail

EXPECTED_GUEST_IMPORT_TESTS=15
EXPECTED_GUEST_IMPORT_TEST_NAMES=(
  "services::wasm_runtime::tests::wasm_guest_imports::translate_conformance_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::detect_conformance_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::baidu_ocr_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_models_conformance_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_chat_conformance_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_models_openai_compatible_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_chat_openai_compatible_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_models_openai_responses_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_chat_openai_responses_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_models_anthropic_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_chat_anthropic_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_models_gemini_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_chat_gemini_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_models_deepseek_guest_imports_only_langnext"
  "services::wasm_runtime::tests::wasm_guest_imports::llm_chat_deepseek_guest_imports_only_langnext"
)

# Captured command output goes to files, never to a here-string or an early-closing pipe.
# A `grep -q` reading a here-string or a `head -1` closing a pipe raises SIGPIPE under
# `set -o pipefail`, which made this task hang on Git Bash. Files live under `target/`
# because mise overrides TMP/TEMP, so `/tmp` writes are not readable in the same shell.
root="$(cd "$(dirname "$0")/../../.." && pwd)"
mkdir -p "${root}/target"
work_dir="$(mktemp -d "${root}/target/plugin-check-no-wasi.XXXXXX")"
trap 'rm -rf "${work_dir}"' EXIT

tree_output_file="${work_dir}/cargo-tree.txt"
test_output_file="${work_dir}/wasm-guest-imports.txt"

# Check 1: cargo tree must succeed. Capture the full output once so a grep miss cannot
# trigger a pipefail/SIGPIPE, then inspect the captured file.
if ! cargo tree --manifest-path "${root}/src-tauri/Cargo.toml" --depth 999 >"${tree_output_file}" 2>&1; then
  echo "error: cargo tree failed; cannot verify dependency tree" >&2
  tail -5 "${tree_output_file}" >&2
  exit 1
fi

# Check 2: the captured host dependency tree must not contain wasmtime-wasi.
if grep -q 'wasmtime-wasi' "${tree_output_file}"; then
  echo "error: wasmtime-wasi is present in the host dependency tree" >&2
  grep 'wasmtime-wasi' "${tree_output_file}" >&2 || true
  exit 1
fi
echo "ok: host dependency tree has no wasmtime-wasi"

# Check 3: all conformance guest Cargo.toml files must not depend on wasi or wasmtime-wasi.
cd "${root}"
for guest_cargo in \
  runtime-plugins/conformance/wasm-component/Cargo.toml \
  runtime-plugins/conformance/wasm-detect-component/Cargo.toml \
  runtime-plugins/baidu-ocr/ocr/Cargo.toml \
  runtime-plugins/conformance/wasm-llm-models-component/Cargo.toml \
  runtime-plugins/conformance/wasm-llm-chat-component/Cargo.toml \
  runtime-plugins/openai-compatible/models/Cargo.toml \
  runtime-plugins/openai-compatible/chat/Cargo.toml \
  runtime-plugins/openai-responses/models/Cargo.toml \
  runtime-plugins/openai-responses/chat/Cargo.toml \
  runtime-plugins/anthropic/models/Cargo.toml \
  runtime-plugins/anthropic/chat/Cargo.toml \
  runtime-plugins/gemini/models/Cargo.toml \
  runtime-plugins/gemini/chat/Cargo.toml \
  runtime-plugins/deepseek/models/Cargo.toml \
  runtime-plugins/deepseek/chat/Cargo.toml; do
  if [[ ! -f "$guest_cargo" ]]; then
    echo "error: guest Cargo.toml missing: $guest_cargo" >&2
    exit 1
  fi
  if grep -qiE 'wasmtime-wasi|^wasi[[:space:]]*=|wasi[[:space:]]*=' "$guest_cargo"; then
    echo "error: $guest_cargo references WASI dependencies" >&2
    grep -niE 'wasmtime-wasi|wasi[[:space:]]*=' "$guest_cargo" >&2 || true
    exit 1
  fi
done
echo "ok: guest Cargo.toml files declare no WASI dependencies"

# Check 4: run guest-import inspection tests and require the exact expected set/count.
# Zero tests succeeding is a hard failure (fail-closed).
if ! cargo test --manifest-path "${root}/src-tauri/Cargo.toml" wasm_guest_imports -- --nocapture >"${test_output_file}" 2>&1; then
  echo "error: guest component import inspection failed" >&2
  cat "${test_output_file}" >&2
  exit 1
fi
cat "${test_output_file}"

PASSED_COUNT="$(awk '/^test result: ok\./ { print $4; exit }' "${test_output_file}")"
if [[ -z "${PASSED_COUNT:-}" || "${PASSED_COUNT}" -lt "$EXPECTED_GUEST_IMPORT_TESTS" ]]; then
  echo "error: wasm_guest_imports ran ${PASSED_COUNT:-0} tests; expected at least $EXPECTED_GUEST_IMPORT_TESTS (fail-closed)" >&2
  exit 1
fi

for name in "${EXPECTED_GUEST_IMPORT_TEST_NAMES[@]}"; do
  if ! grep -Eq "test ${name} \.\.\. ok" "${test_output_file}"; then
    echo "error: required wasm_guest_imports test missing or failed: $name" >&2
    exit 1
  fi
done
echo "ok: compiled conformance guest components import only langnext:runtime-plugin interfaces ($PASSED_COUNT tests)"

echo "ok: no WASI in host dependency tree or guest imports"
