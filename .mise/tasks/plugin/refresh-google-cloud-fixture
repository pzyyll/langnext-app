#!/usr/bin/env bash
# ABOUTME: Refresh the Google Cloud Component and package fixtures.
# ABOUTME: Archives are unsigned; mise run plugin:pack produces the package.
#MISE description="Refresh Google Cloud dev package fixture"
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
STAGING="$ROOT_DIR/runtime-plugins/dist/staging/com.langnext.google-cloud-1.2.0"
PACKAGE="$ROOT_DIR/runtime-plugins/google-cloud/fixtures/com.langnext.google-cloud-1.2.0.lnplugin"
cd "$ROOT_DIR"
mise run plugin:build-google-cloud -- --update-fixtures
mise run plugin:pack -- "$STAGING" "$PACKAGE"
sha256sum "$PACKAGE" | awk '{print $1}' > "$PACKAGE.sha256"
echo "ok: refreshed Google Cloud fixture package (unsigned)"
