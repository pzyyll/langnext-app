#!/usr/bin/env bash
#MISE description="Run the UI tests on the current desktop."
set -euo pipefail

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) target=windows ;;
  Darwin) target=macos ;;
  Linux) target=linux ;;
  *) echo "Unsupported desktop platform" >&2; exit 1 ;;
esac

# These checks need real Win32 monitor and global shortcut services.
if [[ "$target" == windows ]]; then
  nsh test .mise/tests/cursor-match.test.ts --target "$target" "$@"
  nsh test .mise/tests/shortcut-registration.test.ts --target "$target" "$@"
fi

shopt -s globstar nullglob
for file in *.test.tsx components/**/*.test.tsx features/**/*.test.tsx; do
  nsh test "$file" --target "$target" "$@"
done
