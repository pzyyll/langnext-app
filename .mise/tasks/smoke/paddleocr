#!/usr/bin/env bash
# ABOUTME: Launch a Phase 10 PaddleOCR smoke app against the shipped built-in package.
# ABOUTME: Enables the host model Download panel; the preflight fixture stub is not production OCR.
#MISE description="Run PaddleOCR smoke app (arg: --preflight-only)"
set -euo pipefail

readonly PREFLIGHT_ONLY_FLAG="--preflight-only"
readonly PADDLEOCR_PACKAGE_RELATIVE_PATH="runtime-plugins/paddleocr/fixtures/packages/com.langnext.paddleocr-1.0.0.lnplugin"

if [[ "${1:-}" == "--" ]]; then
  shift
fi

case "${1:-}" in
  "") PREFLIGHT_ONLY=0 ;;
  "$PREFLIGHT_ONLY_FLAG") PREFLIGHT_ONLY=1 ;;
  *)
    echo "usage: mise run smoke:paddleocr [--preflight-only]" >&2
    exit 2
    ;;
esac

if [[ $# -gt 1 ]]; then
  echo "usage: mise run smoke:paddleocr [--preflight-only]" >&2
  exit 2
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
PACKAGE_PATH="$ROOT_DIR/$PADDLEOCR_PACKAGE_RELATIVE_PATH"

cd "$ROOT_DIR"

echo "== stage 1: build smoke package fixture"
mise run plugin:build-paddleocr-smoke

[[ -f "$PACKAGE_PATH" ]] || {
  echo "error: PaddleOCR smoke package is missing: $PACKAGE_PATH" >&2
  exit 1
}

echo "== stage 2: focused package/model contracts"
mise run test paddleocr_package -- --nocapture
mise run test plugin_model_status -- --nocapture

echo ""
echo "SMOKE PREFLIGHT PASS: smoke package verified; model status contracts green."
echo "UI expectations after launch (shipped built-in package):"
echo "  1. Remove any existing PaddleOCR instance created before this build"
echo "  2. Create a new PaddleOCR instance (resolves the built-in catalog default)"
echo "  3. Configuration page should show Models + Download for pp-ocrv6-medium"
echo "  4. Status should be Degraded/model_missing until Download succeeds"
echo "Limits:"
echo "  - the preflight fixture uses a protocol-stub worker, not production PaddleOCR"
echo "  - real OCR accuracy remains blocked on LANGNEXT_PADDLE_ROOT + measured inventory"

if [[ $PREFLIGHT_ONLY -eq 1 ]]; then
  echo "ok: paddleocr smoke preflight passed"
  exit 0
fi

echo "ok: launching Tauri (shipped built-in PaddleOCR package)"
mise run tauri:dev
