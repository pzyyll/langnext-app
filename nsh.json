{
  "name": "Langnext",
  "id": "com.dev.langnext",
  "icon": "assets/logos/icon.png",
  "singleInstance": true,
  "version": "0.1.0",
  "build": 1,
  "theme": "theme.json",
  "dependencies": {
    "langnext-native": {
      "path": "ext/langnext-native"
    }
  },
  "tailwind": {
    "radius": {
      "sidebar": 12
    },
    "shadow": {
      "card": "0 2px 8px rgb(15 23 42 / 0.06), 0 1px 2px rgb(15 23 42 / 0.04)",
      "card-dark": "0 4px 12px rgb(0 0 0 / 0.34), 0 1px 3px rgb(0 0 0 / 0.24)",
      "control": "0 1px 2px rgb(15 23 42 / 0.04)"
    }
  },
  "appearance": "system",
  "capabilities": {
    "network": {
      "hosts": ["*"]
    },
    "webview": {
      "hosts": ["*"]
    },
    "statusBar": true,
    "clipboard": true,
    "picker": true,
    "share": true,
    "speech": true,
    "notifications": true,
    "audio": true,
    "application": true,
    "homeDir": true,
    "openUrl": true,
    "windows": true,
    "fs": {
      "read": ["${dataDir}"],
      "write": ["${dataDir}"]
    }
  },
  "window": {
    "title": "Langnext",
    "defaultVisible": false,
    "backdrop": "popover",
    "defaultSize": {
      "width": 1040,
      "height": 720
    },
    "minSize": {
      "width": 720,
      "height": 520
    },
    "titleBar": {
      "style": "hidden",
      "height": 42
    }
  }
}
